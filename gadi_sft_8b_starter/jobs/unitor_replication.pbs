#!/bin/bash
#PBS -P nl78
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l mem=48GB
#PBS -l ngpus=1
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/nl78
#PBS -l wd
#PBS -N unitor-replica
set -euo pipefail
module purge
module load "${PYTHON_MODULE:-python3/3.12.13}"
source "/scratch/nl78/${USER}/venvs/bioasq-8b/bin/activate"
export HF_HOME="/scratch/nl78/${USER}/hf_cache"
export HF_HUB_CACHE="${HF_HOME}/hub"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
args=("${REPLICATION_STAGE:?}" --submission "${REPLICATION_SUBMISSION:?}" --model "${REPLICATION_MODEL:?}")
if [[ "${SMOKE_TEST:-0}" == 1 ]]; then args+=(--smoke); fi
python3 "$REPLICATION_SUBMISSION/code/scripts/run_unitor_replication.py" "${args[@]}"
