#!/bin/bash
#PBS -P nl78
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l mem=32GB
#PBS -l ngpus=1
#PBS -l jobfs=20GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/nl78
#PBS -l wd
#PBS -N bioasq-rerank-smoke

set -euo pipefail

module purge
module load "${PYTHON_MODULE:-python3/3.12.13}"
source "/scratch/nl78/${USER}/venvs/bioasq-8b/bin/activate"

export HF_HOME="/scratch/nl78/${USER}/hf_cache"
export HF_HUB_CACHE="${HF_HOME}/hub"
export TRANSFORMERS_CACHE="${HF_HUB_CACHE}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

cd "${PBS_O_WORKDIR}"
nvidia-smi
python3 scripts/train_neural_cross_encoder_reranker.py \
  --smoke-test \
  --fold 0 \
  --epochs 1 \
  --max-negatives 3 \
  --local-files-only \
  --run-name "biomedbert-reranker-smoke-${PBS_JOBID}"
