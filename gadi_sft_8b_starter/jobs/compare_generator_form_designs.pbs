#!/bin/bash
#PBS -P nl78
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l jobfs=2GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/nl78
#PBS -l wd
#PBS -N form-dpo-compare
set -euo pipefail
module purge
module load "${PYTHON_MODULE:-python3/3.12.13}"
source "/scratch/nl78/${USER}/venvs/bioasq-8b/bin/activate"
export PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
cd "${PBS_O_WORKDIR}"
python3 "$FORM_COMPARISON/code/scripts/evaluate_generator_form_designs.py" --mode compare \
  --submission "${FORM_COMPARISON:?}" --output "$FORM_COMPARISON/comparison-${PBS_JOBID}"
