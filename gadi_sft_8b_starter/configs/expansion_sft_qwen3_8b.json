{
  "description": "Qwen3-8B QLoRA for gold-blind controlled answer expansion using strict teacher-validated training targets.",
  "model_name": "unsloth/Qwen3-8B-unsloth-bnb-4bit",
  "train_input": "../data/BioASQ_expansion_sft/seed3407_teacher_strict_v1/train.jsonl",
  "eval_input": "../data/BioASQ_expansion_sft/seed3407_teacher_strict_v1/validation.jsonl",
  "dataset_manifest": "../data/BioASQ_expansion_sft/seed3407_teacher_strict_v1/manifest.json",
  "chat_template": "qwen",
  "chat_template_kwargs": {
    "enable_thinking": false
  },
  "max_seq_length": 8192,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "warmup_steps": 10,
  "num_train_epochs": 3.0,
  "learning_rate": 0.0002,
  "weight_decay": 0.01,
  "logging_steps": 1,
  "save_strategy": "epoch",
  "lora_r": 32,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "early_stopping_patience": 2,
  "early_stopping_threshold": 0.001,
  "seed": 3407
}
