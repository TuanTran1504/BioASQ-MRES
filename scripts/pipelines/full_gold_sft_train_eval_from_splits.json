{
  "run_name": "full-gold-sft-from-splits-train-eval-sequence",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "full_gold_full_sft_fixed_dir": "data/BioASQ_list_full_gold_in_snippets_sft_fixedsplit",
    "full_gold_first5_sft_fixed_dir": "data/BioASQ_list_full_gold_in_snippets_mr5_sft_fixedsplit",
    "full_gold_test_dir": "data/Task13BTest_list_full_gold_in_snippets",
    "full_gold_full_run_name": "bioasq-8b-full-gold-full-resources-sft",
    "full_gold_first5_run_name": "bioasq-8b-full-gold-first5-resources-sft",
    "full_gold_full_trainer_output": "Artifacts/models/full_gold_sft/full_resources/trainer_output",
    "full_gold_full_adapter_output": "Artifacts/models/full_gold_sft/full_resources/adapter",
    "full_gold_first5_trainer_output": "Artifacts/models/full_gold_sft/first5_resources/trainer_output",
    "full_gold_first5_adapter_output": "Artifacts/models/full_gold_sft/first5_resources/adapter",
    "full_gold_full_original_eval_output": "Artifacts/evaluations/full_gold_sft/full_resources_original_test_mr5",
    "full_gold_full_filtered_eval_output": "Artifacts/evaluations/full_gold_sft/full_resources_full_gold_test_mr5",
    "full_gold_first5_original_eval_output": "Artifacts/evaluations/full_gold_sft/first5_resources_original_test_mr5",
    "full_gold_first5_filtered_eval_output": "Artifacts/evaluations/full_gold_sft/first5_resources_full_gold_test_mr5"
  },
  "steps": [
    {
      "name": "train full gold full resource sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${full_gold_full_sft_fixed_dir}/train_set_answGEN.json",
        "--eval-input",
        "${full_gold_full_sft_fixed_dir}/dev_set_answGEN.json",
        "--question-types",
        "list",
        "--model-name",
        "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "32",
        "--warmup-steps",
        "5",
        "--num-train-epochs",
        "2.0",
        "--learning-rate",
        "6e-4",
        "--weight-decay",
        "0.01",
        "--logging-steps",
        "1",
        "--lora-r",
        "32",
        "--lora-alpha",
        "32",
        "--lora-dropout",
        "0.0",
        "--dataset-num-proc",
        "1",
        "--selection-metric",
        "eval_loss",
        "--early-stopping-patience",
        "2",
        "--early-stopping-threshold",
        "0.002",
        "--run-name",
        "${full_gold_full_run_name}",
        "--output-dir",
        "${full_gold_full_trainer_output}",
        "--save-model-dir",
        "${full_gold_full_adapter_output}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${full_gold_full_adapter_output}/adapter_model.safetensors",
        "${full_gold_full_adapter_output}/tokenizer_config.json"
      ]
    },
    {
      "name": "train full gold first5 resource sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${full_gold_first5_sft_fixed_dir}/train_set_answGEN.json",
        "--eval-input",
        "${full_gold_first5_sft_fixed_dir}/dev_set_answGEN.json",
        "--question-types",
        "list",
        "--model-name",
        "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "32",
        "--warmup-steps",
        "5",
        "--num-train-epochs",
        "2.0",
        "--learning-rate",
        "6e-4",
        "--weight-decay",
        "0.01",
        "--logging-steps",
        "1",
        "--lora-r",
        "32",
        "--lora-alpha",
        "32",
        "--lora-dropout",
        "0.0",
        "--dataset-num-proc",
        "1",
        "--selection-metric",
        "eval_loss",
        "--early-stopping-patience",
        "2",
        "--early-stopping-threshold",
        "0.002",
        "--run-name",
        "${full_gold_first5_run_name}",
        "--output-dir",
        "${full_gold_first5_trainer_output}",
        "--save-model-dir",
        "${full_gold_first5_adapter_output}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${full_gold_first5_adapter_output}/adapter_model.safetensors",
        "${full_gold_first5_adapter_output}/tokenizer_config.json"
      ]
    },
    {
      "name": "evaluate full gold full resource model on original test",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${full_gold_full_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "list",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "2048",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
        "--local-files-only",
        "--output-dir",
        "${full_gold_full_original_eval_output}"
      ],
      "skip_if_exists": [
        "${full_gold_full_original_eval_output}/scores.json",
        "${full_gold_full_original_eval_output}/official_bioasq/official_scores.json"
      ]
    },
    {
      "name": "evaluate full gold full resource model on full gold test",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${full_gold_full_adapter_output}",
        "--eval-input",
        "${full_gold_test_dir}/13B1_golden.json",
        "${full_gold_test_dir}/13B2_golden.json",
        "${full_gold_test_dir}/13B3_golden.json",
        "${full_gold_test_dir}/13B4_golden.json",
        "--question-types",
        "list",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "2048",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
        "--local-files-only",
        "--output-dir",
        "${full_gold_full_filtered_eval_output}"
      ],
      "skip_if_exists": [
        "${full_gold_full_filtered_eval_output}/scores.json",
        "${full_gold_full_filtered_eval_output}/official_bioasq/official_scores.json"
      ]
    },
    {
      "name": "evaluate full gold first5 resource model on original test",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${full_gold_first5_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "list",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "2048",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
        "--local-files-only",
        "--output-dir",
        "${full_gold_first5_original_eval_output}"
      ],
      "skip_if_exists": [
        "${full_gold_first5_original_eval_output}/scores.json",
        "${full_gold_first5_original_eval_output}/official_bioasq/official_scores.json"
      ]
    },
    {
      "name": "evaluate full gold first5 resource model on full gold test",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${full_gold_first5_adapter_output}",
        "--eval-input",
        "${full_gold_test_dir}/13B1_golden.json",
        "${full_gold_test_dir}/13B2_golden.json",
        "${full_gold_test_dir}/13B3_golden.json",
        "${full_gold_test_dir}/13B4_golden.json",
        "--question-types",
        "list",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "2048",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
        "--local-files-only",
        "--output-dir",
        "${full_gold_first5_filtered_eval_output}"
      ],
      "skip_if_exists": [
        "${full_gold_first5_filtered_eval_output}/scores.json",
        "${full_gold_first5_filtered_eval_output}/official_bioasq/official_scores.json"
      ]
    }
  ]
}
