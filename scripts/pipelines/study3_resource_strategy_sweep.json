{
  "run_name": "study3-resource-strategy-sweep",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "study3_root": "Artifacts/Study3",
    "study3_evaluations_root": "${study3_root}/evaluations/resource_strategy_sweep",
    "study3_model_ref": "Artifacts/Study2/models/full_gold_full_resources/adapter",
    "study3_model_slug": "full-gold-full-resources",
    "study3_reranker_model": "ncbi/MedCPT-Query-Encoder",
    "study3_reranker_article_model": "ncbi/MedCPT-Article-Encoder",
    "study3_reranker_device": "cpu",
    "study3_reranker_batch_size": "32",
    "study3_eval_max_seq_length": "4096",
    "study3_eval_max_new_tokens": "512",
    "study3_eval_doc_first_3_output": "${study3_evaluations_root}/doc_first_3",
    "study3_eval_doc_first_5_output": "${study3_evaluations_root}/doc_first_5",
    "study3_eval_doc_first_8_output": "${study3_evaluations_root}/doc_first_8",
    "study3_eval_doc_first_10_output": "${study3_evaluations_root}/doc_first_10",
    "study3_eval_doc_embedding_5_output": "${study3_evaluations_root}/doc_medcpt_5",
    "study3_eval_snippet_first_5_output": "${study3_evaluations_root}/snippet_first_5",
    "study3_eval_snippet_embedding_5_output": "${study3_evaluations_root}/snippet_medcpt_5",
    "study3_eval_snippet_embedding_seq5_output": "${study3_evaluations_root}/snippet_medcpt_seq5"
  },
  "steps": [
    {
      "name": "evaluate study3 model with first 3 documents",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${study3_model_ref}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-resources",
        "3",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "${study3_eval_max_seq_length}",
        "--max-new-tokens",
        "${study3_eval_max_new_tokens}",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
        "--local-files-only",
        "--output-dir",
        "${study3_eval_doc_first_3_output}"
      ],
      "skip_if_exists": [
        "${study3_eval_doc_first_3_output}/${study3_model_slug}/scores.json",
        "${study3_eval_doc_first_3_output}/${study3_model_slug}/official_bioasq/official_scores.json"
      ]
