{
  "run_name": "reproduce-best-list-system-whole-response-dpo-v3",
  "cwd": "${project_root}",
  "env": {
    "UNSLOTH_DISABLE_STATISTICS": "1",
    "PYTORCH_ALLOC_CONF": "expandable_segments:True"
  },
  "variables": {
    "repro_root": "Artifacts/reproductions/best_list_system",
    "raw_train": "data/training13b.json",
    "test_batch_1": "data/Task13BTest/13B1_golden.json",
    "test_batch_2": "data/Task13BTest/13B2_golden.json",
    "test_batch_3": "data/Task13BTest/13B3_golden.json",
    "test_batch_4": "data/Task13BTest/13B4_golden.json",
    "base_model": "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
    "registry": "${repro_root}/model_registry.json",

    "visible_prepared": "${repro_root}/data/mr5_visible_gold",
    "visible_split": "${repro_root}/data/mr5_visible_gold_fixed_split",
    "full_prepared": "${repro_root}/data/full_snippets_fixed_split",

    "full_sft_root": "${repro_root}/models/baseline_full_snippets",
    "full_sft_adapter": "${full_sft_root}/adapter",
    "visible_sft_root": "${repro_root}/models/visible_gold",
    "visible_sft_adapter": "${visible_sft_root}/adapter",

    "candidate_root": "${repro_root}/candidate_bank",
    "candidate_jsonl": "${candidate_root}/baseline-full-snippets/candidate_bank.jsonl",
    "pairs_root": "${repro_root}/pairs",
    "pairs_jsonl": "${pairs_root}/whole_response_mr5_v3.jsonl",
    "pairs_summary": "${pairs_root}/whole_response_mr5_v3.summary.json",
    "pairs_audit": "${pairs_root}/whole_response_mr5_v3.audit.md",

    "dpo_root": "${repro_root}/models/visible_gold_whole_response_dpo_v3",
    "dpo_adapter": "${dpo_root}/adapter",
    "eval_root": "${repro_root}/evaluation",
    "official_scores": "${eval_root}/visible-gold-whole-response-dpo-v3/official_bioasq/official_scores.json"
  },
  "steps": [
    {
      "name": "verify BioASQ inputs and official evaluator",
      "command": [
        "python",
        "scripts/verify_best_list_reproduction.py",
        "inputs",
        "--train-input",
        "${raw_train}",
        "--test-input",
        "${test_batch_1}",
        "${test_batch_2}",
        "${test_batch_3}",
        "${test_batch_4}"
      ]
    },
    {
      "name": "export first-five visible-gold SFT records",
      "command": [
        "python",
        "src/utility/export_mr5_visible_gold_sft.py",
        "--train-input",
        "${raw_train}",
        "--output-dir",
        "${visible_prepared}",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-granularity",
        "document",
        "--min-visible-items",
        "1"
      ],
      "skip_if_exists": [
        "${visible_prepared}/train_set_answGEN.json",
        "${visible_prepared}/conversion_summary.json"
      ]
    },
    {
      "name": "create deterministic visible-gold train dev split",
      "command": [
        "python",
        "src/utility/split_prepared_dataset.py",
        "--input",
        "${visible_prepared}/train_set_answGEN.json",
        "--output-dir",
        "${visible_split}",
        "--validation-ratio",
        "0.1",
        "--seed",
        "3407",
        "--question-types",
        "list",
        "--group-by",
        "id"
      ],
      "skip_if_exists": [
        "${visible_split}/train_set_answGEN.json",
        "${visible_split}/dev_set_answGEN.json",
        "${visible_split}/split_summary.json"
      ]
    },
    {
      "name": "train full-snippet SFT candidate generator",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${raw_train}",
        "--question-types",
        "list",
        "--validation-ratio",
        "0.1",
        "--max-resources",
        "0",
        "--max-resource-chars",
        "0",
        "--prepared-output-dir",
        "${full_prepared}",
        "--model-name",
        "${base_model}",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "32",
        "--warmup-steps",
        "5",
        "--num-train-epochs",
        "2",
        "--learning-rate",
        "6e-4",
        "--weight-decay",
        "0.01",
        "--logging-steps",
        "1",
        "--save-strategy",
        "epoch",
        "--eval-strategy",
        "epoch",
        "--early-stopping-patience",
        "2",
        "--early-stopping-threshold",
        "0.002",
        "--selection-metric",
        "eval_loss",
        "--lora-r",
        "32",
        "--lora-alpha",
        "32",
        "--lora-dropout",
        "0",
        "--dataset-num-proc",
        "1",
        "--seed",
        "3407",
        "--run-name",
        "reproduce-list-baseline-full-snippets",
        "--artifacts-root",
        "${repro_root}/managed_sft_runs",
        "--registry-path",
        "${registry}",
        "--output-dir",
        "${full_sft_root}/trainer_output",
        "--save-model-dir",
        "${full_sft_adapter}"
      ],
      "skip_if_exists": [
        "${full_sft_adapter}/adapter_config.json",
        "${full_sft_adapter}/adapter_model.safetensors"
      ]
    },
    {
      "name": "train first-five visible-gold SFT policy",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${visible_split}/train_set_answGEN.json",
        "--eval-input",
        "${visible_split}/dev_set_answGEN.json",
        "--question-types",
        "list",
        "--model-name",
        "${base_model}",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "32",
        "--warmup-steps",
        "5",
        "--num-train-epochs",
        "2",
        "--learning-rate",
        "6e-4",
        "--weight-decay",
        "0.01",
        "--logging-steps",
        "1",
        "--save-strategy",
        "epoch",
        "--eval-strategy",
        "epoch",
        "--early-stopping-patience",
        "2",
        "--early-stopping-threshold",
        "0.002",
        "--selection-metric",
        "eval_loss",
        "--lora-r",
        "32",
        "--lora-alpha",
        "32",
        "--lora-dropout",
        "0",
        "--dataset-num-proc",
        "1",
        "--seed",
        "3407",
        "--run-name",
        "reproduce-list-visible-gold",
        "--artifacts-root",
        "${repro_root}/managed_sft_runs",
        "--registry-path",
        "${registry}",
        "--output-dir",
        "${visible_sft_root}/trainer_output",
        "--save-model-dir",
        "${visible_sft_adapter}"
      ],
      "skip_if_exists": [
        "${visible_sft_adapter}/adapter_config.json",
        "${visible_sft_adapter}/adapter_model.safetensors"
      ]
    },
    {
      "name": "sample twelve candidates per training question",
      "command": [
        "python",
        "-m",
        "cse_dpo.generate_candidate_bank",
        "--eval-input",
        "${raw_train}",
        "--model-ref",
        "${full_sft_adapter}",
        "--output-dir",
        "${candidate_root}",
        "--dataset-name",
        "bioasq",
        "--question-types",
        "list",
        "--samples-per-question-total",
        "12",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "1024",
        "--temperature",
        "0.7",
        "--top-p",
        "0.9",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--seed",
        "3407",
        "--batch-size",
        "1"
      ],
      "skip_if_exists": [
        "${candidate_jsonl}",
        "${candidate_root}/baseline-full-snippets/manifest.json"
      ]
    },
    {
      "name": "construct whole-response MR5 v3 preference pairs",
      "command": [
        "python",
        "-m",
        "cse_dpo.construct_whole_response_dpo_pairs",
        "--question-input",
        "${raw_train}",
        "--candidate-input",
        "${candidate_jsonl}",
        "--output-jsonl",
        "${pairs_jsonl}",
        "--summary-json",
        "${pairs_summary}",
        "--manual-audit-md",
        "${pairs_audit}",
        "--dataset-name",
        "bioasq",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--gold-support-policy",
        "snippet",
        "--min-delta-f1",
        "0.05",
        "--min-response-f1",
        "0.05",
        "--max-pairs-per-question",
        "8",
        "--max-response-entities",
        "30",
        "--min-delta-recall",
        "0.1",
        "--min-chosen-recall",
        "0.5",
        "--max-entity-gap",
        "8",
        "--max-entity-ratio",
        "2.5",
        "--response-dedupe-mode",
        "exact_unordered",
        "--seed",
        "3407"
      ],
      "skip_if_exists": [
        "${pairs_jsonl}",
        "${pairs_summary}",
        "${pairs_audit}"
      ]
    },
    {
      "name": "train standard whole-response DPO policy",
      "command": [
        "python",
        "src/dpo_train.py",
        "--preference-input",
        "${pairs_jsonl}",
        "--model-name",
        "${visible_sft_adapter}",
        "--output-dir",
        "${dpo_root}/trainer_output",
        "--save-model-dir",
        "${dpo_adapter}",
        "--validation-ratio",
        "0.05",
        "--split-by",
        "question",
        "--seed",
        "3407",
        "--beta",
        "0.1",
        "--loss-type",
        "sigmoid",
        "--learning-rate",
        "5e-6",
        "--num-train-epochs",
        "1",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "8",
        "--warmup-steps",
        "5",
        "--logging-steps",
        "5",
        "--save-steps",
        "50",
        "--selection-metric",
        "eval_loss",
        "--early-stopping-patience",
        "2",
        "--early-stopping-threshold",
        "0",
        "--max-seq-length",
        "2048",
        "--max-prompt-length",
        "1536",
        "--max-completion-length",
        "192",
        "--lora-r",
        "16",
        "--lora-alpha",
        "16",
        "--lora-dropout",
        "0",
        "--reinforce-output-format"
      ],
      "skip_if_exists": [
        "${dpo_adapter}/adapter_config.json",
        "${dpo_adapter}/adapter_model.safetensors",
        "${dpo_adapter}/dpo_manifest.json"
      ]
    },
    {
      "name": "evaluate on BioASQ Task 13B list questions",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${dpo_adapter}",
        "--eval-input",
        "${test_batch_1}",
        "${test_batch_2}",
        "${test_batch_3}",
        "${test_batch_4}",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0",
        "--top-p",
        "1",
        "--score-backend",
        "both",
        "--bioasq-java-version",
        "5",
        "--output-dir",
        "${eval_root}"
      ],
      "skip_if_exists": [
        "${official_scores}"
      ]
    },
    {
      "name": "report reproduced score against historical result",
      "command": [
        "python",
        "scripts/verify_best_list_reproduction.py",
        "result",
        "--scores",
        "${official_scores}",
        "--expected",
        "reproducibility/best_list_system/expected_result.json"
      ]
    }
  ]
}
