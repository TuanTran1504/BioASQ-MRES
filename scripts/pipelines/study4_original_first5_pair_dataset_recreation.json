{
  "run_name": "study4-original-first5-pair-dataset-recreation",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "study4_root": "Artifacts/Study4",
    "study4_question_input": "data/training13b.json",
    "study4_candidate_bank_root": "${study4_root}/candidate_banks/full_gold_model_original_first5_snippets",
    "study4_candidate_bank_model_slug": "full-gold-full-resources",
    "study4_candidate_bank_jsonl": "${study4_candidate_bank_root}/${study4_candidate_bank_model_slug}/candidate_bank.jsonl",

    "study4_recreated_pairs_root": "${study4_root}/pairs/full_gold_model_original_first5_snippets",
    "study4_recreated_study1_pairs_root": "${study4_recreated_pairs_root}/study1",
    "study4_recreated_audits_root": "${study4_root}/audits/full_gold_model_original_first5_snippets",
    "study4_recreated_study1_audits_root": "${study4_recreated_audits_root}/study1",

    "study4_base_pairs_jsonl": "${study4_recreated_pairs_root}/train_8b_whole_response_mr5_dpo.jsonl",
    "study4_base_summary_json": "${study4_recreated_audits_root}/train_8b_whole_response_mr5_dpo_summary.json",
    "study4_base_audit_md": "${study4_recreated_audits_root}/train_8b_whole_response_mr5_dpo_audit.md",

    "study4_v3_pairs_jsonl": "${study4_recreated_pairs_root}/train_8b_whole_response_mr5_dpo_v3.jsonl",
    "study4_v3_summary_json": "${study4_recreated_audits_root}/train_8b_whole_response_mr5_v3_summary.json",
    "study4_v3_audit_md": "${study4_recreated_audits_root}/train_8b_whole_response_mr5_v3_audit.md",

    "study4_model_model_pairs_jsonl": "${study4_recreated_study1_pairs_root}/model_model_pairs.jsonl",
    "study4_model_model_summary_json": "${study4_recreated_study1_audits_root}/model_model_pairs_summary.json",
    "study4_model_model_audit_md": "${study4_recreated_study1_audits_root}/model_model_pairs_audit.md",

    "study4_cardinality_pairs_jsonl": "${study4_recreated_study1_pairs_root}/cardinality_matched_pairs.jsonl",
    "study4_cardinality_summary_json": "${study4_recreated_study1_audits_root}/cardinality_matched_pairs_summary.json"
  },
  "steps": [
    {
      "name": "construct study4 base whole response pairs from original first5 bank",
      "command": [
        "python",
        "-m",
        "cse_dpo.construct_whole_response_dpo_pairs",
        "--question-input",
        "${study4_question_input}",
        "--candidate-input",
        "${study4_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study4_base_pairs_jsonl}",
        "--summary-json",
        "${study4_base_summary_json}",
        "--manual-audit-md",
        "${study4_base_audit_md}",
        "--dataset-name",
        "bioasq",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--gold-support-policy",
        "snippet",
        "--min-delta-f1",
        "0.05",
        "--min-response-f1",
        "0.0",
        "--max-pairs-per-question",
        "8",
        "--response-dedupe-mode",
        "exact_unordered",
        "--seed",
        "3407"
      ],
      "skip_if_exists": [
        "${study4_base_pairs_jsonl}",
        "${study4_base_summary_json}",
        "${study4_base_audit_md}"
      ]
    },
    {
      "name": "construct study4 v3 whole response pairs from original first5 bank",
      "command": [
        "python",
        "-m",
        "cse_dpo.construct_whole_response_dpo_pairs",
        "--question-input",
        "${study4_question_input}",
        "--candidate-input",
        "${study4_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study4_v3_pairs_jsonl}",
        "--summary-json",
        "${study4_v3_summary_json}",
        "--manual-audit-md",
        "${study4_v3_audit_md}",
        "--dataset-name",
        "bioasq",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--gold-support-policy",
        "snippet",
        "--min-delta-f1",
        "0.05",
        "--min-response-f1",
        "0.05",
        "--max-pairs-per-question",
        "8",
        "--max-response-entities",
        "30",
        "--min-delta-recall",
        "0.1",
        "--min-chosen-recall",
        "0.5",
        "--max-entity-gap",
        "8",
        "--max-entity-ratio",
        "2.5",
        "--response-dedupe-mode",
        "exact_unordered",
        "--seed",
        "3407"
      ],
      "skip_if_exists": [
        "${study4_v3_pairs_jsonl}",
        "${study4_v3_summary_json}",
        "${study4_v3_audit_md}"
      ]
    },
    {
      "name": "construct study4 model-model pairs from original first5 bank",
      "command": [
        "python",
        "-m",
        "cse_dpo.construct_whole_response_dpo_pairs",
        "--question-input",
        "${study4_question_input}",
        "--candidate-input",
        "${study4_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study4_model_model_pairs_jsonl}",
        "--summary-json",
        "${study4_model_model_summary_json}",
        "--manual-audit-md",
        "${study4_model_model_audit_md}",
        "--dataset-name",
        "bioasq",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--gold-support-policy",
        "snippet",
        "--min-delta-f1",
        "0.01",
        "--min-response-f1",
        "0.05",
        "--max-pairs-per-question",
        "8",
        "--max-response-entities",
        "30",
        "--max-entity-gap",
        "8",
        "--max-entity-ratio",
        "2.5",
        "--response-dedupe-mode",
        "exact_unordered",
        "--seed",
        "3407"
      ],
      "skip_if_exists": [
        "${study4_model_model_pairs_jsonl}",
        "${study4_model_model_summary_json}",
        "${study4_model_model_audit_md}"
      ]
    },
    {
      "name": "filter study4 model-model pairs into cardinality-matched subset",
      "command": [
        "python",
        "-m",
        "cse_dpo.filter_preference_pairs",
        "--input-jsonl",
        "${study4_model_model_pairs_jsonl}",
        "--output-jsonl",
        "${study4_cardinality_pairs_jsonl}",
        "--summary-json",
        "${study4_cardinality_summary_json}",
        "--pair-type",
        "whole_response_metric",
        "--require-equal-cardinality"
      ],
      "skip_if_exists": [
        "${study4_cardinality_pairs_jsonl}",
        "${study4_cardinality_summary_json}"
      ]
    }
  ]
}
