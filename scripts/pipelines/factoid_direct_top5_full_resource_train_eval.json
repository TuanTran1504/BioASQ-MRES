{
  "run_name": "factoid-direct-top5-full-resource-train-eval",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "factoid_root": "Artifacts/Factoid_SFT",
    "factoid_models_root": "${factoid_root}/models",
    "factoid_evaluations_root": "${factoid_root}/evaluations",
    "factoid_prepared_root": "data/BioASQ_factoid_sft_prepared",

    "factoid_direct_top5_prepared_dir": "${factoid_prepared_root}/direct_top5_hard_negative_full_resources",
    "factoid_direct_top5_train_input": "${factoid_direct_top5_prepared_dir}/train_prepared.json",
    "factoid_direct_top5_eval_input": "${factoid_direct_top5_prepared_dir}/eval_prepared.json",
    "factoid_direct_top5_eval_input_gold_only": "${factoid_direct_top5_prepared_dir}/eval_prepared_gold_only.json",

    "factoid_direct_top5_prompt_file": "prompts/factoid_single_answer_aligned.json",
    "factoid_direct_top5_prompt_ref": "factoid-top-five-eval-v1",

    "factoid_direct_top5_run_name": "bioasq-8b-factoid-direct-top5-full-resources-gold-eval-sft",
    "factoid_direct_top5_model_slug": "direct-top5-full-resources-gold-eval",
    "factoid_direct_top5_trainer_output": "${factoid_models_root}/direct_top5_full_resources_gold_eval/trainer_output",
    "factoid_direct_top5_adapter_output": "${factoid_models_root}/direct_top5_full_resources_gold_eval/adapter",

    "factoid_direct_top5_eval_output": "${factoid_evaluations_root}/direct_top5_original_test_full_resources_gold_eval",

    "factoid_base_model": "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
    "factoid_chat_template": "llama-3",
    "factoid_prompt_format": "chat",
    "factoid_seed": "3407",

    "factoid_train_batch_size": "1",
    "factoid_eval_batch_size": "1",
    "factoid_gradient_accumulation_steps": "32",
    "factoid_warmup_steps": "5",
    "factoid_num_train_epochs": "6.0",
    "factoid_learning_rate": "6e-4",
    "factoid_weight_decay": "0.01",
    "factoid_logging_steps": "1",
    "factoid_save_steps": "25",
    "factoid_eval_steps": "25",
    "factoid_lora_r": "32",
    "factoid_lora_alpha": "32",
    "factoid_lora_dropout": "0.05",
    "factoid_dataset_num_proc": "1",
    "factoid_early_stopping_patience": "3",
    "factoid_early_stopping_threshold": "0.001",
    "factoid_selection_metric": "generated_primary_score",
    "factoid_selection_num_generations": "1",
    "factoid_selection_max_new_tokens": "128",
    "factoid_selection_max_seq_length": "3584",
    "factoid_selection_aggregation_strategy": "union",

    "factoid_eval_max_new_tokens": "128"
  },
  "steps": [
    {
      "name": "prepare gold-only direct-top5 eval file for checkpoint selection",
      "command": [
        "python",
        "src/utility/convert_factoid_prepared_eval_to_gold_only.py",
        "--input-prepared",
        "${factoid_direct_top5_eval_input}",
        "--output-prepared",
        "${factoid_direct_top5_eval_input_gold_only}"
      ],
      "skip_if_exists": [
        "${factoid_direct_top5_eval_input_gold_only}"
      ]
    },
    {
      "name": "train factoid direct-top5 full-resource sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${factoid_direct_top5_train_input}",
        "--eval-input",
        "${factoid_direct_top5_eval_input_gold_only}",
        "--question-types",
        "factoid",
        "--validation-ratio",
        "0.0",
        "--model-name",
        "${factoid_base_model}",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--prompt-file",
        "${factoid_direct_top5_prompt_file}",
        "--prompt",
        "${factoid_direct_top5_prompt_ref}",
        "--max-seq-length",
        "4096",
        "--per-device-train-batch-size",
        "${factoid_train_batch_size}",
        "--per-device-eval-batch-size",
        "${factoid_eval_batch_size}",
        "--gradient-accumulation-steps",
        "${factoid_gradient_accumulation_steps}",
        "--warmup-steps",
        "${factoid_warmup_steps}",
        "--num-train-epochs",
        "${factoid_num_train_epochs}",
        "--learning-rate",
        "${factoid_learning_rate}",
        "--weight-decay",
        "${factoid_weight_decay}",
        "--logging-steps",
        "${factoid_logging_steps}",
        "--save-strategy",
        "steps",
        "--save-steps",
        "${factoid_save_steps}",
        "--lora-r",
        "${factoid_lora_r}",
        "--lora-alpha",
        "${factoid_lora_alpha}",
        "--lora-dropout",
        "${factoid_lora_dropout}",
        "--dataset-num-proc",
        "${factoid_dataset_num_proc}",
        "--selection-metric",
        "${factoid_selection_metric}",
        "--selection-max-seq-length",
        "${factoid_selection_max_seq_length}",
        "--selection-max-new-tokens",
        "${factoid_selection_max_new_tokens}",
        "--selection-num-generations",
        "${factoid_selection_num_generations}",
        "--selection-aggregation-strategy",
        "${factoid_selection_aggregation_strategy}",
        "--early-stopping-patience",
        "${factoid_early_stopping_patience}",
        "--early-stopping-threshold",
        "${factoid_early_stopping_threshold}",
        "--seed",
        "${factoid_seed}",
        "--run-name",
        "${factoid_direct_top5_run_name}",
        "--output-dir",
        "${factoid_direct_top5_trainer_output}",
        "--save-model-dir",
        "${factoid_direct_top5_adapter_output}",
        "--register-alias",
        "factoid-sft-direct-top5-full-resources-gold-eval",
        "--resume-from-checkpoint",
        "auto",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${factoid_direct_top5_adapter_output}/training_complete.json"
      ]
    },
    {
      "name": "evaluate factoid direct-top5 model on original test with full resources",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${factoid_direct_top5_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "factoid",
        "--prompt-file",
        "${factoid_direct_top5_prompt_file}",
        "--prompt",
        "${factoid_direct_top5_prompt_ref}",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--max-resources",
        "0",
        "--max-resource-chars",
        "0",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-factoid-answers",
        "5",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "${factoid_eval_max_new_tokens}",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "bioasq_java",
        "--local-files-only",
        "--output-dir",
        "${factoid_direct_top5_eval_output}"
      ],
      "skip_if_exists": [
        "${factoid_direct_top5_eval_output}/${factoid_direct_top5_model_slug}/scores.json",
        "${factoid_direct_top5_eval_output}/${factoid_direct_top5_model_slug}/official_bioasq/official_scores.json"
      ]
    }
  ]
}
