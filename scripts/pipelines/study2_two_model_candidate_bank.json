{
  "run_name": "study2-two-model-candidate-bank-generation",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "candidate_question_input": "data/training13b.json",
    "candidate_bank_root": "Artifacts/cse_dpo/candidate_banks/study2_two_model_train",
    "candidate_model_a_ref": "Artifacts/Study2/models/original_full_resources/adapter",
    "candidate_model_a_slug": "original-full-resources",
    "candidate_model_b_ref": "Artifacts/Study2/models/visible_gold_mr5_resources/adapter",
    "candidate_model_b_slug": "visible-gold-mr5-resources",
    "candidate_model_a_dir": "${candidate_bank_root}/${candidate_model_a_slug}",
    "candidate_model_b_dir": "${candidate_bank_root}/${candidate_model_b_slug}",
    "candidate_dataset_name": "bioasq",
    "candidate_samples_per_question_total": "12",
    "candidate_max_resources": "5",
    "candidate_max_resource_chars": "1200",
    "candidate_max_seq_length": "4096",
    "candidate_max_new_tokens": "512",
    "candidate_temperature": "0.7",
    "candidate_top_p": "0.9",
    "candidate_batch_size": "1"
  },
  "steps": [
    {
      "name": "generate candidate bank with model A",
      "command": [
        "python",
        "-m",
        "cse_dpo.generate_candidate_bank",
        "--eval-input",
        "${candidate_question_input}",
        "--model-ref",
        "${candidate_model_a_ref}",
        "--output-dir",
        "${candidate_bank_root}",
        "--dataset-name",
        "${candidate_dataset_name}",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--samples-per-question-total",
        "${candidate_samples_per_question_total}",
        "--max-resources",
        "${candidate_max_resources}",
        "--max-resource-chars",
        "${candidate_max_resource_chars}",
        "--max-seq-length",
        "${candidate_max_seq_length}",
        "--max-new-tokens",
        "${candidate_max_new_tokens}",
        "--temperature",
        "${candidate_temperature}",
        "--top-p",
        "${candidate_top_p}",
        "--batch-size",
        "${candidate_batch_size}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${candidate_model_a_dir}/candidate_bank.jsonl",
        "${candidate_model_a_dir}/manifest.json"
      ]
    },
    {
      "name": "generate candidate bank with model B",
      "command": [
        "python",
        "-m",
        "cse_dpo.generate_candidate_bank",
        "--eval-input",
        "${candidate_question_input}",
        "--model-ref",
        "${candidate_model_b_ref}",
        "--output-dir",
        "${candidate_bank_root}",
        "--dataset-name",
        "${candidate_dataset_name}",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--samples-per-question-total",
        "${candidate_samples_per_question_total}",
        "--max-resources",
        "${candidate_max_resources}",
        "--max-resource-chars",
        "${candidate_max_resource_chars}",
        "--max-seq-length",
        "${candidate_max_seq_length}",
        "--max-new-tokens",
        "${candidate_max_new_tokens}",
        "--temperature",
        "${candidate_temperature}",
        "--top-p",
        "${candidate_top_p}",
        "--batch-size",
        "${candidate_batch_size}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${candidate_model_b_dir}/candidate_bank.jsonl",
        "${candidate_model_b_dir}/manifest.json"
      ]
    }
  ]
}
