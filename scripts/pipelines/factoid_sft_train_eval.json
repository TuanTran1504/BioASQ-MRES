{
  "run_name": "factoid-sft-train-eval-matrix",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "factoid_root": "Artifacts/Factoid_SFT",
    "factoid_models_root": "${factoid_root}/models",
    "factoid_evaluations_root": "${factoid_root}/evaluations",
    "factoid_prepared_root": "data/BioASQ_factoid_sft_prepared",

    "factoid_train_input": "data/training13b.json",

    "factoid_mr5_prepared_dir": "${factoid_prepared_root}/original_mr5",
    "factoid_full_prepared_dir": "${factoid_prepared_root}/original_full_resources",

    "factoid_mr5_run_name": "bioasq-8b-factoid-mr5-sft",
    "factoid_full_run_name": "bioasq-8b-factoid-full-resources-sft",

    "factoid_mr5_model_slug": "mr5-resources",
    "factoid_full_model_slug": "full-resources",

    "factoid_mr5_trainer_output": "${factoid_models_root}/mr5_resources/trainer_output",
    "factoid_mr5_adapter_output": "${factoid_models_root}/mr5_resources/adapter",
    "factoid_full_trainer_output": "${factoid_models_root}/full_resources/trainer_output",
    "factoid_full_adapter_output": "${factoid_models_root}/full_resources/adapter",

    "factoid_eval_mr5_output": "${factoid_evaluations_root}/original_test_mr5",
    "factoid_eval_full_output": "${factoid_evaluations_root}/original_test_full_resources",

    "factoid_base_model": "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
    "factoid_chat_template": "llama-3",
    "factoid_prompt_format": "chat",
    "factoid_seed": "3407",

    "factoid_train_batch_size": "1",
    "factoid_eval_batch_size": "1",
    "factoid_gradient_accumulation_steps": "32",
    "factoid_warmup_steps": "5",
    "factoid_num_train_epochs": "6.0",
    "factoid_learning_rate": "6e-4",
    "factoid_weight_decay": "0.01",
    "factoid_logging_steps": "1",
    "factoid_save_steps": "25",
    "factoid_lora_r": "32",
    "factoid_lora_alpha": "32",
    "factoid_lora_dropout": "0.0",
    "factoid_dataset_num_proc": "1",
    "factoid_early_stopping_patience": "3",
    "factoid_early_stopping_threshold": "0.001",
    "factoid_selection_metric": "generated_primary_score",
    "factoid_selection_num_generations": "1",
    "factoid_selection_max_new_tokens": "64",
    "factoid_selection_aggregation_strategy": "union",

    "factoid_eval_max_new_tokens": "64"
  },
  "steps": [
    {
      "name": "train factoid mr5 sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${factoid_train_input}",
        "--question-types",
        "factoid",
        "--validation-ratio",
        "0.1",
        "--prepared-output-dir",
        "${factoid_mr5_prepared_dir}",
        "--model-name",
        "${factoid_base_model}",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--max-factoid-answers",
        "5",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "${factoid_train_batch_size}",
        "--per-device-eval-batch-size",
        "${factoid_eval_batch_size}",
        "--gradient-accumulation-steps",
        "${factoid_gradient_accumulation_steps}",
        "--warmup-steps",
        "${factoid_warmup_steps}",
        "--num-train-epochs",
        "${factoid_num_train_epochs}",
        "--learning-rate",
        "${factoid_learning_rate}",
        "--weight-decay",
        "${factoid_weight_decay}",
        "--logging-steps",
        "${factoid_logging_steps}",
        "--save-strategy",
        "steps",
        "--save-steps",
        "${factoid_save_steps}",
        "--lora-r",
        "${factoid_lora_r}",
        "--lora-alpha",
        "${factoid_lora_alpha}",
        "--lora-dropout",
        "${factoid_lora_dropout}",
        "--dataset-num-proc",
        "${factoid_dataset_num_proc}",
        "--selection-metric",
        "${factoid_selection_metric}",
        "--selection-max-seq-length",
        "1792",
        "--selection-max-new-tokens",
        "${factoid_selection_max_new_tokens}",
        "--selection-num-generations",
        "${factoid_selection_num_generations}",
        "--selection-aggregation-strategy",
        "${factoid_selection_aggregation_strategy}",
        "--early-stopping-patience",
        "${factoid_early_stopping_patience}",
        "--early-stopping-threshold",
        "${factoid_early_stopping_threshold}",
        "--seed",
        "${factoid_seed}",
        "--run-name",
        "${factoid_mr5_run_name}",
        "--output-dir",
        "${factoid_mr5_trainer_output}",
        "--save-model-dir",
        "${factoid_mr5_adapter_output}",
        "--register-alias",
        "factoid-sft-mr5",
        "--resume-from-checkpoint",
        "auto",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${factoid_mr5_adapter_output}/training_complete.json"
      ]
    },
    {
      "name": "train factoid full-resource sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${factoid_train_input}",
        "--question-types",
        "factoid",
        "--validation-ratio",
        "0.1",
        "--prepared-output-dir",
        "${factoid_full_prepared_dir}",
        "--model-name",
        "${factoid_base_model}",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--max-resources",
        "0",
        "--max-resource-chars",
        "0",
        "--max-factoid-answers",
        "5",
        "--max-seq-length",
        "4096",
        "--per-device-train-batch-size",
        "${factoid_train_batch_size}",
        "--per-device-eval-batch-size",
        "${factoid_eval_batch_size}",
        "--gradient-accumulation-steps",
        "${factoid_gradient_accumulation_steps}",
        "--warmup-steps",
        "${factoid_warmup_steps}",
        "--num-train-epochs",
        "${factoid_num_train_epochs}",
        "--learning-rate",
        "${factoid_learning_rate}",
        "--weight-decay",
        "${factoid_weight_decay}",
        "--logging-steps",
        "${factoid_logging_steps}",
        "--save-strategy",
        "steps",
        "--save-steps",
        "${factoid_save_steps}",
        "--lora-r",
        "${factoid_lora_r}",
        "--lora-alpha",
        "${factoid_lora_alpha}",
        "--lora-dropout",
        "${factoid_lora_dropout}",
        "--dataset-num-proc",
        "${factoid_dataset_num_proc}",
        "--selection-metric",
        "${factoid_selection_metric}",
        "--selection-max-seq-length",
        "3584",
        "--selection-max-new-tokens",
        "${factoid_selection_max_new_tokens}",
        "--selection-num-generations",
        "${factoid_selection_num_generations}",
        "--selection-aggregation-strategy",
        "${factoid_selection_aggregation_strategy}",
        "--early-stopping-patience",
        "${factoid_early_stopping_patience}",
        "--early-stopping-threshold",
        "${factoid_early_stopping_threshold}",
        "--seed",
        "${factoid_seed}",
        "--run-name",
        "${factoid_full_run_name}",
        "--output-dir",
        "${factoid_full_trainer_output}",
        "--save-model-dir",
        "${factoid_full_adapter_output}",
        "--register-alias",
        "factoid-sft-full-resources",
        "--resume-from-checkpoint",
        "auto",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${factoid_full_adapter_output}/training_complete.json"
      ]
    },
    {
      "name": "evaluate factoid mr5 model on original test with mr5 resources",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${factoid_mr5_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "factoid",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-factoid-answers",
        "5",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "${factoid_eval_max_new_tokens}",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "bioasq_java",
        "--local-files-only",
        "--output-dir",
        "${factoid_eval_mr5_output}"
      ],
      "skip_if_exists": [
        "${factoid_eval_mr5_output}/${factoid_mr5_model_slug}/scores.json",
        "${factoid_eval_mr5_output}/${factoid_mr5_model_slug}/official_bioasq/official_scores.json"
      ]
    },
    {
      "name": "evaluate factoid full-resource model on original test with mr5 resources",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${factoid_full_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "factoid",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-factoid-answers",
        "5",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "${factoid_eval_max_new_tokens}",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "bioasq_java",
        "--local-files-only",
        "--output-dir",
        "${factoid_eval_mr5_output}"
      ],
      "skip_if_exists": [
        "${factoid_eval_mr5_output}/${factoid_full_model_slug}/scores.json",
        "${factoid_eval_mr5_output}/${factoid_full_model_slug}/official_bioasq/official_scores.json"
      ]
    },
    {
      "name": "evaluate factoid mr5 model on original test with full resources",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${factoid_mr5_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "factoid",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--max-resources",
        "0",
        "--max-resource-chars",
        "0",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-factoid-answers",
        "5",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "${factoid_eval_max_new_tokens}",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "bioasq_java",
        "--local-files-only",
        "--output-dir",
        "${factoid_eval_full_output}"
      ],
      "skip_if_exists": [
        "${factoid_eval_full_output}/${factoid_mr5_model_slug}/scores.json",
        "${factoid_eval_full_output}/${factoid_mr5_model_slug}/official_bioasq/official_scores.json"
      ]
    },
    {
      "name": "evaluate factoid full-resource model on original test with full resources",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${factoid_full_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "factoid",
        "--chat-template",
        "${factoid_chat_template}",
        "--prompt-format",
        "${factoid_prompt_format}",
        "--max-resources",
        "0",
        "--max-resource-chars",
        "0",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-factoid-answers",
        "5",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "${factoid_eval_max_new_tokens}",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "bioasq_java",
        "--local-files-only",
        "--output-dir",
        "${factoid_eval_full_output}"
      ],
      "skip_if_exists": [
        "${factoid_eval_full_output}/${factoid_full_model_slug}/scores.json",
        "${factoid_eval_full_output}/${factoid_full_model_slug}/official_bioasq/official_scores.json"
      ]
    }
  ]
}
