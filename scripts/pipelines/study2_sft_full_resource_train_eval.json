{
  "run_name": "study2-sft-full-resource-train-eval-sequence",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "study2_root": "Artifacts/Study2",
    "study2_models_root": "${study2_root}/models",
    "study2_evaluations_root": "${study2_root}/evaluations",
    "original_full_sft_fixed_dir": "data/BioASQ_list_original_full_snippets_sft_fixedsplit",
    "full_gold_full_sft_fixed_dir": "data/BioASQ_list_full_gold_in_snippets_sft_fixedsplit",
    "visible_gold_mr5_sft_fixed_dir": "data/BioASQ_list_mr5_visible_gold_sft_fixedsplit",
    "study2_original_run_name": "study2-bioasq-8b-original-full-resources-sft",
    "study2_full_gold_run_name": "study2-bioasq-8b-full-gold-full-resources-sft",
    "study2_visible_gold_run_name": "study2-bioasq-8b-visible-gold-sft",
    "study2_original_trainer_output": "${study2_models_root}/original_full_resources/trainer_output",
    "study2_original_adapter_output": "${study2_models_root}/original_full_resources/adapter",
    "study2_full_gold_trainer_output": "${study2_models_root}/full_gold_full_resources/trainer_output",
    "study2_full_gold_adapter_output": "${study2_models_root}/full_gold_full_resources/adapter",
    "study2_visible_gold_trainer_output": "${study2_models_root}/visible_gold_mr5_resources/trainer_output",
    "study2_visible_gold_adapter_output": "${study2_models_root}/visible_gold_mr5_resources/adapter",
    "study2_original_original_eval_output": "${study2_evaluations_root}/original_full_resources_original_test_mr5",
    "study2_full_gold_original_eval_output": "${study2_evaluations_root}/full_gold_full_resources_original_test_mr5",
    "study2_visible_gold_original_eval_output": "${study2_evaluations_root}/visible_gold_mr5_resources_original_test_mr5"
  },
  "steps": [
    {
      "name": "train study2 original full resource sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${original_full_sft_fixed_dir}/train_set_answGEN.json",
        "--eval-input",
        "${original_full_sft_fixed_dir}/dev_set_answGEN.json",
        "--question-types",
        "list",
        "--model-name",
        "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "32",
        "--warmup-steps",
        "5",
        "--num-train-epochs",
        "6.0",
        "--learning-rate",
        "6e-4",
        "--weight-decay",
        "0.01",
        "--logging-steps",
        "1",
        "--save-strategy",
        "steps",
        "--save-steps",
        "50",
        "--lora-r",
        "32",
        "--lora-alpha",
        "32",
        "--lora-dropout",
        "0.0",
        "--dataset-num-proc",
        "1",
        "--selection-metric",
        "generated_mean_f1",
        "--selection-max-seq-length",
        "1792",
        "--selection-max-new-tokens",
        "256",
        "--selection-num-generations",
        "1",
        "--selection-aggregation-strategy",
        "union",
        "--early-stopping-patience",
        "3",
        "--early-stopping-threshold",
        "0.002",
        "--run-name",
        "${study2_original_run_name}",
        "--output-dir",
        "${study2_original_trainer_output}",
        "--save-model-dir",
        "${study2_original_adapter_output}",
        "--resume-from-checkpoint",
        "auto",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study2_original_adapter_output}/training_complete.json"
      ]
    },
    {
      "name": "train study2 full gold full resource sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${full_gold_full_sft_fixed_dir}/train_set_answGEN.json",
        "--eval-input",
        "${full_gold_full_sft_fixed_dir}/dev_set_answGEN.json",
        "--question-types",
        "list",
        "--model-name",
        "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "32",
        "--warmup-steps",
        "5",
        "--num-train-epochs",
        "6.0",
        "--learning-rate",
        "6e-4",
        "--weight-decay",
        "0.01",
        "--logging-steps",
        "1",
        "--save-strategy",
        "steps",
        "--save-steps",
        "50",
        "--lora-r",
        "32",
        "--lora-alpha",
        "32",
        "--lora-dropout",
        "0.0",
        "--dataset-num-proc",
        "1",
        "--selection-metric",
        "generated_mean_f1",
        "--selection-max-seq-length",
        "1792",
        "--selection-max-new-tokens",
        "256",
        "--selection-num-generations",
        "1",
        "--selection-aggregation-strategy",
        "union",
        "--early-stopping-patience",
        "3",
        "--early-stopping-threshold",
        "0.002",
        "--run-name",
        "${study2_full_gold_run_name}",
        "--output-dir",
        "${study2_full_gold_trainer_output}",
        "--save-model-dir",
        "${study2_full_gold_adapter_output}",
        "--resume-from-checkpoint",
        "auto",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study2_full_gold_adapter_output}/training_complete.json"
      ]
    },
    {
      "name": "train study2 visible gold mr5 sft model",
      "command": [
        "python",
        "src/utility/answer_gen_ft.py",
        "--train-input",
        "${visible_gold_mr5_sft_fixed_dir}/train_set_answGEN.json",
        "--eval-input",
        "${visible_gold_mr5_sft_fixed_dir}/dev_set_answGEN.json",
        "--question-types",
        "list",
        "--model-name",
        "unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-seq-length",
        "2048",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "32",
        "--warmup-steps",
        "5",
        "--num-train-epochs",
        "6.0",
        "--learning-rate",
        "6e-4",
        "--weight-decay",
        "0.01",
        "--logging-steps",
        "1",
        "--save-strategy",
        "steps",
        "--save-steps",
        "50",
        "--lora-r",
        "32",
        "--lora-alpha",
        "32",
        "--lora-dropout",
        "0.0",
        "--dataset-num-proc",
        "1",
        "--selection-metric",
        "generated_mean_f1",
        "--selection-max-seq-length",
        "1792",
        "--selection-max-new-tokens",
        "256",
        "--selection-num-generations",
        "1",
        "--selection-aggregation-strategy",
        "union",
        "--early-stopping-patience",
        "3",
        "--early-stopping-threshold",
        "0.002",
        "--run-name",
        "${study2_visible_gold_run_name}",
        "--output-dir",
        "${study2_visible_gold_trainer_output}",
        "--save-model-dir",
        "${study2_visible_gold_adapter_output}",
        "--resume-from-checkpoint",
        "auto",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study2_visible_gold_adapter_output}/training_complete.json"
      ]
    },
    {
      "name": "evaluate study2 original full resource model on original test",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${study2_original_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "list",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
        "--local-files-only",
        "--output-dir",
        "${study2_original_original_eval_output}"
      ],
      "skip_if_exists": [
        "${study2_original_original_eval_output}/scores.json",
        "${study2_original_original_eval_output}/official_bioasq/official_scores.json"
      ]
    },
    {
      "name": "evaluate study2 full gold full resource model on original test",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${study2_full_gold_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "list",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
