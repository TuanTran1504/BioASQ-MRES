{
  "run_name": "study6-task-dcrm-pair-generation",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1",
    "PYTORCH_ALLOC_CONF": "expandable_segments:True"
  },
  "variables": {
    "study6_root": "Artifacts/Study6",
    "study6_candidate_banks_root": "${study6_root}/candidate_banks",
    "study6_scored_candidate_banks_root": "${study6_root}/scored_candidate_banks",
    "study6_pairs_root": "${study6_root}/pairs",
    "study6_audits_root": "${study6_root}/audits",

    "study6_question_input": "data/training13b.json",
    "study6_model_ref": "Artifacts/Study2/models/full_gold_full_resources/adapter",
    "study6_model_slug": "full-gold-full-resources",
    "study6_dataset_slug": "full_gold_model_original_first5_snippets_n5",
    "study6_source_candidate_bank_jsonl": "Artifacts/Study4/candidate_banks/full_gold_model_original_first5_snippets/full-gold-full-resources/candidate_bank.jsonl",

    "study6_candidate_bank_root": "${study6_candidate_banks_root}/${study6_dataset_slug}",
    "study6_candidate_bank_model_dir": "${study6_candidate_bank_root}/${study6_model_slug}",
    "study6_candidate_bank_jsonl": "${study6_candidate_bank_model_dir}/candidate_bank.jsonl",
    "study6_candidate_bank_subset_summary_json": "${study6_candidate_bank_model_dir}/subset_summary.json",

    "study6_scored_candidate_bank_jsonl": "${study6_scored_candidate_banks_root}/${study6_dataset_slug}/${study6_model_slug}/candidate_bank_scored.jsonl",
    "study6_scored_candidate_bank_summary_json": "${study6_scored_candidate_banks_root}/${study6_dataset_slug}/${study6_model_slug}/scoring_summary.json",

    "study6_f1_pairs_jsonl": "${study6_pairs_root}/${study6_dataset_slug}/task_dcrm_f1.jsonl",
    "study6_f1_summary_json": "${study6_audits_root}/${study6_dataset_slug}/task_dcrm_f1_summary.json",
    "study6_f1_audit_md": "${study6_audits_root}/${study6_dataset_slug}/task_dcrm_f1_audit.md",

    "study6_f1_recall_pairs_jsonl": "${study6_pairs_root}/${study6_dataset_slug}/task_dcrm_f1_recall.jsonl",
    "study6_f1_recall_summary_json": "${study6_audits_root}/${study6_dataset_slug}/task_dcrm_f1_recall_summary.json",
    "study6_f1_recall_audit_md": "${study6_audits_root}/${study6_dataset_slug}/task_dcrm_f1_recall_audit.md",

    "study6_f1_recall_gap_pairs_jsonl": "${study6_pairs_root}/${study6_dataset_slug}/task_dcrm_f1_recall_entity_gap.jsonl",
    "study6_f1_recall_gap_summary_json": "${study6_audits_root}/${study6_dataset_slug}/task_dcrm_f1_recall_entity_gap_summary.json",
    "study6_f1_recall_gap_audit_md": "${study6_audits_root}/${study6_dataset_slug}/task_dcrm_f1_recall_entity_gap_audit.md"
  },
  "steps": [
    {
      "name": "subset study6 candidate bank from study4 original first5 snippets",
      "command": [
        "python",
        "-m",
        "cse_dpo.filter_candidate_bank_rows",
        "--input-jsonl",
        "${study6_source_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study6_candidate_bank_jsonl}",
        "--summary-json",
        "${study6_candidate_bank_subset_summary_json}",
        "--min-sample-id",
        "0",
        "--max-sample-id",
        "4"
      ],
      "skip_if_exists": [
        "${study6_candidate_bank_jsonl}",
        "${study6_candidate_bank_subset_summary_json}"
      ]
    },
    {
      "name": "score study6 candidate bank with full gold model logprobs",
      "command": [
        "python",
        "-m",
        "cse_dpo.score_candidate_bank",
        "--candidate-input",
        "${study6_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study6_scored_candidate_bank_jsonl}",
        "--summary-json",
        "${study6_scored_candidate_bank_summary_json}",
        "--model-ref",
        "${study6_model_ref}",
        "--completion-source",
        "parsed",
        "--batch-size",
        "1",
        "--max-seq-length",
        "4096",
        "--empty-cuda-cache-steps",
        "1",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study6_scored_candidate_bank_jsonl}",
        "${study6_scored_candidate_bank_summary_json}"
      ]
    },
    {
      "name": "construct study6 task-dcrm f1 pairs",
      "command": [
        "python",
        "-m",
        "cse_dpo.construct_task_dcrm_pairs",
        "--question-input",
        "${study6_question_input}",
        "--candidate-input",
        "${study6_scored_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study6_f1_pairs_jsonl}",
        "--summary-json",
        "${study6_f1_summary_json}",
        "--manual-audit-md",
        "${study6_f1_audit_md}",
        "--dataset-name",
        "bioasq",
        "--reference-logp-field",
        "policy_logp_sum",
        "--completion-source",
        "parsed",
        "--reward-formula",
        "f1",
        "--tokenizer-model-ref",
        "${study6_model_ref}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study6_f1_pairs_jsonl}",
        "${study6_f1_summary_json}",
        "${study6_f1_audit_md}"
      ]
    },
    {
      "name": "construct study6 task-dcrm f1 recall pairs",
      "command": [
        "python",
        "-m",
        "cse_dpo.construct_task_dcrm_pairs",
        "--question-input",
        "${study6_question_input}",
        "--candidate-input",
        "${study6_scored_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study6_f1_recall_pairs_jsonl}",
        "--summary-json",
        "${study6_f1_recall_summary_json}",
        "--manual-audit-md",
        "${study6_f1_recall_audit_md}",
        "--dataset-name",
        "bioasq",
        "--reference-logp-field",
        "policy_logp_sum",
        "--completion-source",
        "parsed",
        "--reward-formula",
        "f1_recall",
        "--tokenizer-model-ref",
        "${study6_model_ref}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study6_f1_recall_pairs_jsonl}",
        "${study6_f1_recall_summary_json}",
        "${study6_f1_recall_audit_md}"
      ]
    },
    {
      "name": "construct study6 task-dcrm f1 recall entity gap pairs",
      "command": [
        "python",
        "-m",
        "cse_dpo.construct_task_dcrm_pairs",
        "--question-input",
        "${study6_question_input}",
        "--candidate-input",
        "${study6_scored_candidate_bank_jsonl}",
        "--output-jsonl",
        "${study6_f1_recall_gap_pairs_jsonl}",
        "--summary-json",
        "${study6_f1_recall_gap_summary_json}",
        "--manual-audit-md",
        "${study6_f1_recall_gap_audit_md}",
        "--dataset-name",
        "bioasq",
        "--reference-logp-field",
        "policy_logp_sum",
        "--completion-source",
        "parsed",
        "--reward-formula",
        "f1_recall_entity_gap",
        "--tokenizer-model-ref",
        "${study6_model_ref}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study6_f1_recall_gap_pairs_jsonl}",
        "${study6_f1_recall_gap_summary_json}",
        "${study6_f1_recall_gap_audit_md}"
      ]
    }
  ]
}
