{
  "run_name": "study4-full-gold-candidate-bank-resource-sweep",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1"
  },
  "variables": {
    "study4_root": "Artifacts/Study4",
    "study4_full_gold_question_input": "data/training13b_list_full_gold_in_snippets.json",
    "study4_original_question_input": "data/training13b.json",
    "study4_model_ref": "Artifacts/Study2/models/full_gold_full_resources/adapter",
    "study4_model_slug": "full-gold-full-resources",
    "study4_samples_per_question_total": "12",
    "study4_max_resource_chars": "0",
    "study4_max_seq_length": "131072",
    "study4_max_new_tokens": "1024",
    "study4_temperature": "0.7",
    "study4_top_p": "0.9",
    "study4_batch_size": "1",
    "study4_full_gold_data_root": "${study4_root}/candidate_banks/full_gold_model_full_gold_data",
    "study4_original_full_resources_root": "${study4_root}/candidate_banks/full_gold_model_original_full_resources",
    "study4_original_first5_snippets_root": "${study4_root}/candidate_banks/full_gold_model_original_first5_snippets",
    "study4_full_gold_data_model_dir": "${study4_full_gold_data_root}/${study4_model_slug}",
    "study4_original_full_resources_model_dir": "${study4_original_full_resources_root}/${study4_model_slug}",
    "study4_original_first5_snippets_model_dir": "${study4_original_first5_snippets_root}/${study4_model_slug}"
  },
  "steps": [
    {
      "name": "generate study4 candidate bank with full gold data",
      "command": [
        "python",
        "-m",
        "cse_dpo.generate_candidate_bank",
        "--eval-input",
        "${study4_full_gold_question_input}",
        "--model-ref",
        "${study4_model_ref}",
        "--output-dir",
        "${study4_full_gold_data_root}",
        "--dataset-name",
        "study4-full-gold-data",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--samples-per-question-total",
        "${study4_samples_per_question_total}",
        "--max-resources",
        "0",
        "--max-resource-chars",
        "${study4_max_resource_chars}",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "snippet",
        "--max-seq-length",
        "${study4_max_seq_length}",
        "--max-new-tokens",
        "${study4_max_new_tokens}",
        "--temperature",
        "${study4_temperature}",
        "--top-p",
        "${study4_top_p}",
        "--batch-size",
        "${study4_batch_size}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study4_full_gold_data_model_dir}/candidate_bank.jsonl",
        "${study4_full_gold_data_model_dir}/manifest.json"
      ]
    },
    {
      "name": "generate study4 candidate bank with original data full resources",
      "command": [
        "python",
        "-m",
        "cse_dpo.generate_candidate_bank",
        "--eval-input",
        "${study4_original_question_input}",
        "--model-ref",
        "${study4_model_ref}",
        "--output-dir",
        "${study4_original_full_resources_root}",
        "--dataset-name",
        "study4-original-full-resources",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--samples-per-question-total",
        "${study4_samples_per_question_total}",
        "--max-resources",
        "0",
        "--max-resource-chars",
        "${study4_max_resource_chars}",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "snippet",
        "--max-seq-length",
        "${study4_max_seq_length}",
        "--max-new-tokens",
        "${study4_max_new_tokens}",
        "--temperature",
        "${study4_temperature}",
        "--top-p",
        "${study4_top_p}",
        "--batch-size",
        "${study4_batch_size}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study4_original_full_resources_model_dir}/candidate_bank.jsonl",
        "${study4_original_full_resources_model_dir}/manifest.json"
      ]
    },
    {
      "name": "generate study4 candidate bank with original data first 5 snippets",
      "command": [
        "python",
        "-m",
        "cse_dpo.generate_candidate_bank",
        "--eval-input",
        "${study4_original_question_input}",
        "--model-ref",
        "${study4_model_ref}",
        "--output-dir",
        "${study4_original_first5_snippets_root}",
        "--dataset-name",
        "study4-original-first5-snippets",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--samples-per-question-total",
        "${study4_samples_per_question_total}",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "${study4_max_resource_chars}",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "snippet",
        "--max-seq-length",
        "${study4_max_seq_length}",
        "--max-new-tokens",
        "${study4_max_new_tokens}",
        "--temperature",
        "${study4_temperature}",
        "--top-p",
        "${study4_top_p}",
        "--batch-size",
        "${study4_batch_size}",
        "--local-files-only"
      ],
      "skip_if_exists": [
        "${study4_original_first5_snippets_model_dir}/candidate_bank.jsonl",
        "${study4_original_first5_snippets_model_dir}/manifest.json"
      ]
    }
  ]
}
