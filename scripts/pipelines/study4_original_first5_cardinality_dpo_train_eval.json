{
  "run_name": "study4-original-first5-cardinality-dpo-train-eval",
  "cwd": "${project_root}",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "UNSLOTH_DISABLE_STATISTICS": "1",
    "PYTORCH_ALLOC_CONF": "expandable_segments:True"
  },
  "variables": {
    "study4_root": "Artifacts/Study4",
    "study4_models_root": "${study4_root}/models/full_gold_model_original_first5_snippets",
    "study4_evaluations_root": "${study4_root}/evaluations/full_gold_model_original_first5_snippets",
    "study4_base_model_ref": "Artifacts/Study2/models/full_gold_full_resources/adapter",
    "study4_cardinality_pairs": "Artifacts/Study4/pairs/full_gold_model_original_first5_snippets/study1/cardinality_matched_pairs.jsonl",

    "study4_cardinality_eval_loss_trainer_output": "${study4_models_root}/cardinality_matched_pairs_eval_loss/trainer_output",
    "study4_cardinality_eval_loss_adapter_output": "${study4_models_root}/cardinality_matched_pairs_eval_loss/adapter",
    "study4_cardinality_eval_loss_model_slug": "cardinality-matched-pairs-eval-loss",
    "study4_cardinality_eval_loss_eval_output": "${study4_evaluations_root}/cardinality_matched_pairs_eval_loss_original_test_mr5"
  },
  "steps": [
    {
      "name": "train study4 original first5 cardinality dpo model (eval loss selection)",
      "command": [
        "python",
        "src/dpo_train.py",
        "--preference-input",
        "${study4_cardinality_pairs}",
        "--model-name",
        "${study4_base_model_ref}",
        "--output-dir",
        "${study4_cardinality_eval_loss_trainer_output}",
        "--save-model-dir",
        "${study4_cardinality_eval_loss_adapter_output}",
        "--resume-from-checkpoint",
        "auto",
        "--max-seq-length",
        "2048",
        "--max-prompt-length",
        "1536",
        "--max-completion-length",
        "192",
        "--validation-ratio",
        "0.05",
        "--split-by",
        "question",
        "--beta",
        "0.1",
        "--learning-rate",
        "5e-6",
        "--num-train-epochs",
        "1.0",
        "--per-device-train-batch-size",
        "1",
        "--per-device-eval-batch-size",
        "1",
        "--gradient-accumulation-steps",
        "8",
        "--warmup-steps",
        "5",
        "--precompute-ref-log-probs",
        "--precompute-ref-batch-size",
        "1",
        "--logging-steps",
        "5",
        "--save-steps",
        "50",
        "--torch-empty-cache-steps",
        "1",
        "--selection-metric",
        "eval_loss",
        "--early-stopping-patience",
        "2",
        "--early-stopping-threshold",
        "0.0",
        "--local-files-only",
        "--save-dtype",
        "float32"
      ],
      "skip_if_exists": [
        "${study4_cardinality_eval_loss_adapter_output}/dpo_manifest.json"
      ]
    },
    {
      "name": "evaluate study4 original first5 cardinality dpo model (eval loss selection) on original test",
      "command": [
        "python",
        "src/utility/evaluate_models.py",
        "--model-ref",
        "${study4_cardinality_eval_loss_adapter_output}",
        "--eval-input",
        "data/Task13BTest/13B1_golden.json",
        "data/Task13BTest/13B2_golden.json",
        "data/Task13BTest/13B3_golden.json",
        "data/Task13BTest/13B4_golden.json",
        "--question-types",
        "list",
        "--chat-template",
        "llama-3",
        "--prompt-format",
        "chat",
        "--max-resources",
        "5",
        "--max-resource-chars",
        "1200",
        "--resource-selection",
        "first",
        "--resource-granularity",
        "document",
        "--max-seq-length",
        "4096",
        "--max-new-tokens",
        "512",
        "--num-generations",
        "1",
        "--temperature",
        "0.0",
        "--top-p",
        "1.0",
        "--score-backend",
        "both",
        "--local-files-only",
        "--output-dir",
        "${study4_cardinality_eval_loss_eval_output}"
      ],
      "skip_if_exists": [
        "${study4_cardinality_eval_loss_eval_output}/${study4_cardinality_eval_loss_model_slug}/scores.json",
        "${study4_cardinality_eval_loss_eval_output}/${study4_cardinality_eval_loss_model_slug}/official_bioasq/official_scores.json"
      ]
    }
  ]
}
